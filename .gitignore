# ============================================================
# BakeFlow — .gitignore
# ============================================================

# ---- Build output directories ----
x64/
Debug/
Release/
bin/
obj/

# ---- Visual Studio project/user files ----
.vs/
*.user
*.suo
*.VC.db
*.VC.VC.opendb
*.vcxproj.user
*.vcxproj.filters
*.sdf
*.opensdf
*.ncb
*.pch

# ---- Compiled binary artifacts ----
*.exe
*.dll
*.pdb
*.ilk
*.obj
*.lib
*.idb
*.exp
*.sbr

# ---- SQLite database (auto-generated on first run) ----
*.db
*.db-shm
*.db-wal

# ---- Log files ----
*.log

# ---- Temporary/backup files ----
*.tmp
*.bak
*.orig

# ---- OS-specific files ----
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ---- Resharper ----
_ReSharper*/
*.DotSettings.user